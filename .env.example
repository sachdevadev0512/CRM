# Supabase Credentials: Required to connect to your Supabase project.
# Configure these in the AI Studio Secrets panel.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare Turnstile: protects the public application form from bot submissions.
# VITE_TURNSTILE_SITEKEY is public (shipped to the browser); TURNSTILE_SECRET_KEY is
# server-only and used by /api/verify-turnstile to validate tokens with Cloudflare.
# For local development, Cloudflare publishes an always-pass test pair:
#   VITE_TURNSTILE_SITEKEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
VITE_TURNSTILE_SITEKEY=""
TURNSTILE_SECRET_KEY=""

# SMTP: used to send administrator invitation emails directly (server.ts's own
# nodemailer transporter), instead of relying on Supabase Auth's built-in mailer.
# Supabase still generates the invite token/link (auth.admin.generateLink); we just
# deliver it ourselves via this SMTP account. SMTP_FROM/SMTP_FROM_NAME are optional
# and default to SMTP_USER / "Middha Ventures" respectively.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME=""
